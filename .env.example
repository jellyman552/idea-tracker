# Copy to .env and fill in. Never commit .env.

# Your hostname (no https://). Must point at this server.
DOMAIN=ideas.example.com

# Login for the web app, created on first start. Change the password here and
# restart to reset it.
ADMIN_USERNAME=me
ADMIN_PASSWORD=change-me-to-something-long

# Session signing key. Generate: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=change-me

# Secret for the MCP URL (https://DOMAIN/mcp/<MCP_TOKEN>). At least 32 characters.
# Generate the same way as SECRET_KEY. Leave empty to turn the MCP server off.
MCP_TOKEN=

# Timezone used to display dates (IANA name).
TIMEZONE=America/Los_Angeles

# Optional: a fine-grained, read-only GitHub token (Contents: read) to sync
# commits from repos you link to projects. See "GitHub commits" in the README.
# GITHUB_TOKEN=

# Optional: defaults to sqlite:///instance/tracker.db
# DATABASE_URL=sqlite:////absolute/path/to/tracker.db
